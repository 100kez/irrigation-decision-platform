# ============================================================
# 灌溉决策平台 环境变量示例
# 复制本文件为 .env 并填入实际值: cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 数据库连接 (必填)
# ------------------------------------------------------------
# PostgreSQL 完整连接串 (平台默认变量名)
SUDA_DATABASE_URL=postgresql://username:password@localhost:5432/irrigation_db

# ------------------------------------------------------------
# AI 大模型配置 (可选, 不配置则 AI 诊断使用内置降级回复)
# 接口协议: OpenAI 兼容 (chat/completions)
# ------------------------------------------------------------
# AI API 基础地址 (默认 DeepSeek)
AI_BASE_URL=https://api.deepseek.com/v1
# AI API 密钥
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI 模型名称
AI_MODEL=deepseek-chat

# 其他 AI 服务商示例 (修改上面三个变量即可):
# - 智谱AI:     AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4   AI_MODEL=glm-4-flash
# - 月之暗面:   AI_BASE_URL=https://api.moonshot.cn/v1             AI_MODEL=moonshot-v1-8k
# - 硅基流动:   AI_BASE_URL=https://api.siliconflow.cn/v1          AI_MODEL=Qwen/Qwen2.5-7B-Instruct
# - Ollama本地: AI_BASE_URL=http://localhost:11434/v1              AI_MODEL=qwen2.5:7b
# - 豆包/火山:  AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  AI_MODEL=doubao-lite-4k

# ------------------------------------------------------------
# 服务端配置 (可选, 有默认值)
# ------------------------------------------------------------
# 服务监听地址
SERVER_HOST=0.0.0.0
# 服务监听端口
SERVER_PORT=3000
# 运行环境: development / production
NODE_ENV=production

# ------------------------------------------------------------
# 日志配置 (可选)
# ------------------------------------------------------------
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ------------------------------------------------------------
# 前端开发代理 (仅开发环境需要, 可选)
# ------------------------------------------------------------
# Vite dev server 端口
# VITE_PORT=5173
